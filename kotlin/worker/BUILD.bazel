load("@rules_java//java:java_binary.bzl", "java_binary")
load("@rules_java//java:java_import.bzl", "java_import")
load("@rules_java//java:java_library.bzl", "java_library")

java_library(
    name = "worker_protocol",
    srcs = ["WorkerProtocol.java"],
)

java_binary(
    name = "builder",
    srcs = ["KotlinBuilder.java"],
    jvm_flags = [
        "-Xss8m",
        "-Xmx8g",
        # Idle workers return their heap to the OS; several output bases may run workers at once.
        "-XX:+UseG1GC",
        "-XX:G1PeriodicGCInterval=15000",
        "-XX:MinHeapFreeRatio=10",
        "-XX:MaxHeapFreeRatio=30",
        "-XX:ReservedCodeCacheSize=512m",
        "-Dfile.encoding=UTF-8",
        "-Djava.awt.headless=true",
        "-Didea.io.use.nio2=true",
        "-Dkotlin.environment.keepalive=true",
    ],
    main_class = "de.voize.bazel.kotlin.KotlinBuilder",
    visibility = ["//visibility:public"],
    deps = [":worker_protocol"],
)

# kotlin-metadata-jvm, and the ASM the compiler ships (shaded), at the toolchain's version.
java_import(
    name = "kotlin_metadata",
    jars = [
        "@kotlin_compiler//:lib/kotlin-metadata-jvm.jar",
        "@kotlin_compiler//:lib/kotlin-stdlib.jar",
        "@kotlin_compiler//:lib/kotlin-compiler.jar",
    ],
)

java_binary(
    name = "classpath_filter",
    srcs = [
        "ClasspathFilter.java",
        "RawJar.java",
    ],
    jvm_flags = [
        "-Xmx2g",
        "-XX:+UseG1GC",
        "-XX:G1PeriodicGCInterval=15000",
        "-XX:MinHeapFreeRatio=10",
        "-XX:MaxHeapFreeRatio=30",
        "-Dfile.encoding=UTF-8",
    ],
    main_class = "de.voize.bazel.kotlin.ClasspathFilter",
    visibility = ["//visibility:public"],
    deps = [
        ":kotlin_metadata",
        ":worker_protocol",
    ],
)
