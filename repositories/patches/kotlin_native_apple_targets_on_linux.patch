From 2068e032d4f64e5abd5e159e41b90117803a296c Mon Sep 17 00:00:00 2001
From: Reuben Morais <reuben.morais@gmail.com>
Date: Thu, 22 Oct 2026 18:20:53 +0200
Subject: [PATCH] [K/N] Allow Apple targets on non-Mac hosts with a configured
 toolchain

Apple targets were only enabled on macOS hosts, because the compiler finds
the SDK and toolchain through Xcode. Code generation itself only needs
LLVM, so producing static caches, for example, works on Linux once the
compiler is told where to find an Apple-compatible toolchain.

On a host other than macOS, an Apple target is now enabled when the
properties name a toolchain for it (targetToolchain.<host>-<target>). Its
SDK is targetSysRoot.<target>; both are laid out as in Xcode and are
resolved like other dependencies, so absolute paths work too. On macOS,
configuredAppleToolchain=true selects the same toolchain instead of Xcode,
so a Mac builds static caches as other hosts do.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../jetbrains/kotlin/konan/target/Apple.kt    | 39 ++++++++++++-------
 .../kotlin/konan/target/HostManager.kt        |  4 +-
 .../jetbrains/kotlin/konan/target/Platform.kt | 13 +++++++
 3 files changed, 39 insertions(+), 17 deletions(-)

diff --git a/native/utils/src/org/jetbrains/kotlin/konan/target/Apple.kt b/native/utils/src/org/jetbrains/kotlin/konan/target/Apple.kt
index 06f9e5966bc7..95caac44e03d 100644
--- a/native/utils/src/org/jetbrains/kotlin/konan/target/Apple.kt
+++ b/native/utils/src/org/jetbrains/kotlin/konan/target/Apple.kt
@@ -30,7 +30,7 @@ class AppleConfigurablesImpl(
 
     private val sdkDependency = this.targetSysRoot!!
     private val toolchainDependency = this.targetToolchain!!
-    private val xcodeAddonDependency = this.additionalToolsDir!!
+    private val xcodeAddonDependency = this.additionalToolsDir
 
     override val absoluteTargetSysRoot: String get() = when (val provider = xcodePartsProvider) {
         is XcodePartsProvider.Local -> {
@@ -38,41 +38,44 @@ class AppleConfigurablesImpl(
             val platformName = if (targetTriple.isMacabi) "MacOSX" else platformName()
             provider.xcode.pathToPlatformSdk(platformName)
         }
-        XcodePartsProvider.InternalServer -> absolute(sdkDependency)
+        XcodePartsProvider.InternalServer, XcodePartsProvider.Configured -> absolute(sdkDependency)
     }
 
     override val absoluteTargetToolchain: String get() = when (val provider = xcodePartsProvider) {
         is XcodePartsProvider.Local -> provider.xcode.toolchain
-        XcodePartsProvider.InternalServer -> "${absolute(toolchainDependency)}/usr"
+        XcodePartsProvider.InternalServer, XcodePartsProvider.Configured -> "${absolute(toolchainDependency)}/usr"
     }
 
     override val absoluteAdditionalToolsDir: String get() = when (val provider = xcodePartsProvider) {
         is XcodePartsProvider.Local -> provider.xcode.additionalTools
-        XcodePartsProvider.InternalServer -> absolute(additionalToolsDir)
+        XcodePartsProvider.InternalServer, XcodePartsProvider.Configured ->
+            absolute(xcodeAddonDependency ?: error("additionalToolsDir is not set for this host"))
     }
 
     override val dependencies
         get() = super.dependencies +
-                if (InternalServer.isAvailable) listOf(
+                if (InternalServer.isAvailable) listOfNotNull(
                     sdkDependency,
                     toolchainDependency,
                     xcodeAddonDependency
                 ) else emptyList()
 
     private val xcodePartsProvider by lazy {
-        if (InternalServer.isAvailable) {
-            XcodePartsProvider.InternalServer
-        } else {
-            val xcode = Xcode.findCurrent()
+        when {
+            InternalServer.isAvailable -> XcodePartsProvider.InternalServer
+            !HostManager.hostIsMac || properties.getProperty("configuredAppleToolchain") == "true" -> XcodePartsProvider.Configured
+            else -> {
+                val xcode = Xcode.findCurrent()
 
-            if (properties.getProperty("ignoreXcodeVersionCheck") != "true") {
-                properties.getProperty("minimalXcodeVersion")?.let(XcodeVersion::parse)?.let { minimalXcodeVersion ->
-                    val currentXcodeVersion = xcode.version
-                    checkXcodeVersion(minimalXcodeVersion, currentXcodeVersion)
+                if (properties.getProperty("ignoreXcodeVersionCheck") != "true") {
+                    properties.getProperty("minimalXcodeVersion")?.let(XcodeVersion::parse)?.let { minimalXcodeVersion ->
+                        val currentXcodeVersion = xcode.version
+                        checkXcodeVersion(minimalXcodeVersion, currentXcodeVersion)
+                    }
                 }
-            }
 
-            XcodePartsProvider.Local(xcode)
+                XcodePartsProvider.Local(xcode)
+            }
         }
     }
 
@@ -85,6 +88,12 @@ class AppleConfigurablesImpl(
     private sealed class XcodePartsProvider {
         class Local(val xcode: Xcode) : XcodePartsProvider()
         object InternalServer : XcodePartsProvider()
+
+        /**
+         * Without Xcode (a host other than macOS, or configuredAppleToolchain=true): the SDK and toolchain are those named by
+         * `targetSysRoot.<target>` and `targetToolchain.<host>-<target>`, laid out as in Xcode.
+         */
+        object Configured : XcodePartsProvider()
     }
 }
 
diff --git a/native/utils/src/org/jetbrains/kotlin/konan/target/HostManager.kt b/native/utils/src/org/jetbrains/kotlin/konan/target/HostManager.kt
index a5f32023b9df..de23f22d6dfb 100644
--- a/native/utils/src/org/jetbrains/kotlin/konan/target/HostManager.kt
+++ b/native/utils/src/org/jetbrains/kotlin/konan/target/HostManager.kt
@@ -59,7 +59,7 @@ open class HostManager() {
         ANDROID_ARM64,
     )
 
-    private val appleTargets = setOf(
+    protected val appleTargets = setOf(
         MACOS_X64,
         MACOS_ARM64,
         IOS_ARM64,
@@ -82,7 +82,7 @@ open class HostManager() {
         MACOS_ARM64 to commonTargets + appleTargets
     )
 
-    val enabled: List<KonanTarget>
+    open val enabled: List<KonanTarget>
         get() = enabledByHost[host]?.toList() ?: throw TargetSupportException("Unknown host platform: $host")
 
     fun isEnabled(target: KonanTarget) = enabled.contains(target)
diff --git a/native/utils/src/org/jetbrains/kotlin/konan/target/Platform.kt b/native/utils/src/org/jetbrains/kotlin/konan/target/Platform.kt
index cbdcc2536685..ddc4899d89ad 100644
--- a/native/utils/src/org/jetbrains/kotlin/konan/target/Platform.kt
+++ b/native/utils/src/org/jetbrains/kotlin/konan/target/Platform.kt
@@ -16,6 +16,8 @@
 
 package org.jetbrains.kotlin.konan.target
 
+import org.jetbrains.kotlin.konan.properties.hostTargetString
+
 class Platform(val configurables: Configurables) : Configurables by configurables {
 
     val clang: ClangArgs.Native by lazy {
@@ -49,6 +51,17 @@ class PlatformManager private constructor(private val serialized: Serialized) :
 
     private val distribution by serialized::distribution
 
+    /**
+     * Besides the host's own targets, the Apple targets for which the properties name an Apple toolchain for this host
+     * (`targetToolchain.<host>-<target>`), when the host is not a Mac. Their SDK is `targetSysRoot.<target>`.
+     */
+    override val enabled: List<KonanTarget> by lazy {
+        val configuredAppleTargets = if (hostIsMac) emptyList() else appleTargets.filter {
+            distribution.properties.hostTargetString("targetToolchain", it, host) != null
+        }
+        super.enabled + configuredAppleTargets
+    }
+
     private val loaders = enabled.map {
         it to loadConfigurables(it, distribution.properties, distribution.dependenciesDir)
     }.toMap()
-- 
2.55.0

